# PowerTwin backend image.
#
# The image is built in two stages. The builder stage carries the compiler
# toolchain; the runtime stage does not. A container image is a deployed
# artefact, not a build environment, so nothing that exists only to compile
# source code belongs in it. Leaving `build-essential` and `libpq-dev` in the
# final layer added `linux-libc-dev`, the Kerberos chain and the whole GCC
# binutils tree to the shipped attack surface, and the container security gate
# reported them as HIGH severity operating-system findings.
#
# The base image is pinned by digest, so a rebuild of the same commit resolves
# to the same operating-system snapshot. `apt-get upgrade` below moves the
# runtime layer to the newest packages the distribution currently publishes, so
# that a patch released after the base image was built is still applied.
#
# The runtime container runs as a non-root user and its health probe uses the
# Python standard library only, so the image ships no extra HTTP client.
#
# SECURITY: no credentials, no private keys and no connection details of real
# equipment belong in this file.

# =============================================================================
# Stage 1 — builder
# =============================================================================
FROM python:3.12-slim@sha256:191083cdf6c7bda8c76158983163ead5d5cf7b77cf3033e805bb0f5296f51b4b AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# The toolchain lives here and only here. Every runtime dependency in
# backend/requirements.lock ships a manylinux wheel, so the compiler is a
# fallback for a platform without one rather than the normal path.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt backend/requirements.lock /tmp/

# A self-contained virtual environment is copied into the runtime stage as a
# whole, so the runtime never needs a package manager, a compiler or a
# network connection to install anything.
#
# The dependencies are installed from the lock, with --require-hashes, so the
# image contains exactly one known version of every package and pip refuses to
# install anything whose hash does not match the recorded one. The lock is
# generated from backend/requirements.txt by pip-compile and is checked
# against it by scripts/check_dependency_lock.py, so it cannot drift away
# from the declared ranges.
#
# The package installer and the wheel builder are removed again once the
# dependencies are in place. A deployed artefact is not a build environment,
# and neither of them is a runtime dependency of this service.
#
# Python 3.12 no longer installs setuptools into a fresh virtual environment,
# and nothing in this service needs it, so the runtime layer carries only the
# packages of the lock, each of them hash-verified.
#
# The wheel builder has a dependency of its own - `packaging`, the only
# distribution it requires - which has to go with it: removing the builder
# alone leaves that dependency behind, and the environment would then carry a
# package that no hash in the lock covers. The strict verification below is
# what proves the claim, rather than leaving it to the reading of an
# uninstall chain.
COPY scripts/verify_locked_environment.py /tmp/verify_locked_environment.py

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip wheel \
    && /opt/venv/bin/pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock \
    && /opt/venv/bin/pip uninstall -y wheel \
    && /opt/venv/bin/pip uninstall -y packaging \
    && /opt/venv/bin/pip uninstall -y pip \
    && rm -f /opt/venv/bin/pip /opt/venv/bin/pip3 /opt/venv/bin/pip3.12 \
    && /opt/venv/bin/python /tmp/verify_locked_environment.py \
        --lock /tmp/requirements.lock --strict \
    && /opt/venv/bin/python -c "import bcrypt, fastapi, httpx, jwt, passlib, psycopg2, pydantic, pymodbus, sqlalchemy, uvicorn, yaml"

# =============================================================================
# Stage 2 — runtime
# =============================================================================
FROM python:3.12-slim@sha256:191083cdf6c7bda8c76158983163ead5d5cf7b77cf3033e805bb0f5296f51b4b AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/venv/bin:${PATH}"

# Apply every operating-system patch the distribution currently publishes.
# The base image is a point-in-time snapshot; without this step a fix released
# after that snapshot was taken would not reach the deployed container.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# The base image ships pip for the system interpreter. The runtime layer has
# no use for a package installer: the dependencies were installed in the
# builder stage and were hash-verified there, and the container runs as a
# non-root user that cannot write to the system site-packages in any case.
# Removing it means the shipped image carries no way to install anything at
# run time, which is what "a container image is a deployed artefact, not a
# build environment" has to mean in practice.
RUN rm -rf /usr/local/lib/python3.12/site-packages/pip \
    && rm -rf /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
    && rm -f /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

COPY backend/ /app/backend/
COPY plugins/ /app/plugins/
COPY configs/ /app/configs/
COPY tests/ /app/tests/
COPY deployment/healthcheck.py /app/deployment/healthcheck.py

# The service account is a fixed non-root uid so that a bind-mounted volume
# can be given matching ownership from the host.
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin powertwin \
    && chown -R powertwin:powertwin /app

USER powertwin

EXPOSE 8000

# The probe uses the Python standard library, so the image needs no curl and
# no other HTTP client in its runtime layer.
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=3 \
    CMD ["/opt/venv/bin/python", "/app/deployment/healthcheck.py", "/health/readiness"]

CMD ["/opt/venv/bin/uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
