# PowerTwin Environment Variables Template
ENVIRONMENT=development
DEBUG=True

# Server Setup
HOST=0.0.0.0
PORT=8000

# Database Settings
POSTGRES_SERVER=timescaledb
POSTGRES_PORT=5432
POSTGRES_USER=powertwin
POSTGRES_PASSWORD=<your-secure-password>
POSTGRES_DB=powertwin_db

# Logging
LOG_LEVEL=INFO
JSON_LOGS=False
