# PowerTwin Environment Variables Template
#
# Copy this file to `.env` in the repository root and fill in the secrets.
# `.env` is git-ignored: never commit a filled-in copy.
#
# SAFETY: the API server binds to the loopback interface by default. Binding a
# writable control interface to an untrusted network is a safety violation
# (see backend/app/core/safety.py). Keep HOST on 127.0.0.1 unless the
# deployment is behind a trusted reverse proxy and has been reviewed.

ENVIRONMENT=development
DEBUG=True

# Server Setup
HOST=127.0.0.1
PORT=8000

# Database Settings
POSTGRES_SERVER=timescaledb
POSTGRES_PORT=5432
POSTGRES_USER=powertwin
# MUST be set to a strong secret of at least 20 characters. It is deliberately
# left empty: a placeholder value such as `<your-secure-password>` would be a
# publicly known credential if this template were copied verbatim.
# The Compose files use the fail-fast form ${POSTGRES_PASSWORD:?...}, so an
# unset value aborts the deployment instead of starting the historian with a
# guessable password.
POSTGRES_PASSWORD=
POSTGRES_DB=powertwin_db

# Authentication & Security
# JWT_SECRET_KEY signs every session token. It MUST be at least 32 characters
# in production; generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave it unset in development: a random per-process key is generated instead.
# JWT_SECRET_KEY=
LOGIN_RATE_LIMIT=5
LOGIN_LOCKOUT_SECONDS=60

# Protocol Gateway / CIL Settings
# External controller writes are DISABLED by default. Enabling them requires a
# deliberate operator action and a loopback PROTOCOL_GATEWAY_HOST.
ALLOW_EXTERNAL_MODBUS_WRITES=False
PROTOCOL_GATEWAY_HOST=127.0.0.1
PROTOCOL_GATEWAY_PORT=5020

# Simulation Defaults
SIMULATION_TICK_RATE_HZ=100
SIMULATION_SPEED_FACTOR=1.0
SIMULATION_RANDOM_SEED=42
# TOPOLOGY_CONFIG_PATH=configs/reference_10mw_20mwh.yaml

# Logging
LOG_LEVEL=INFO
JSON_LOGS=False
